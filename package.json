{
  "name": "infusion-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "npx prisma generate",
    "qa:build": "npm run db:push -- --accept-data-loss && npm run db:seed && npm run build",
    "qa:start": "npm run build && cross-env ALLOW_LOCAL_PREVIEW=true next start",
    "qa:web": "node scripts/qa-web.mjs",
    "qa:offline": "powershell -ExecutionPolicy Bypass -File scripts/qa-offline-static.ps1",
    "qa:all": "npm run qa:web && npm run qa:offline",
    "test:api": "node scripts/api-smoke.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "android:init": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "android:build:offline": "powershell -ExecutionPolicy Bypass -File scripts/build-apk-offline.ps1"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.9.1",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/dialog": "^8.0.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/app": "^8.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.1.1",
    "@prisma/client": "^6.11.1",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.525.0",
    "next": "16.2.9",
    "next-auth": "5.0.0-beta.29",
    "papaparse": "^5.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.60.0",
    "simplex-noise": "^4.0.3",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/cli": "^7.4.2",
    "@capacitor/core": "^7.4.2",
    "@capacitor/splash-screen": "^7.0.1",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "20.19.43",
    "@types/papaparse": "^5.5.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "localtunnel": "^2.0.2",
    "prisma": "^6.11.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "5.9.3"
  }
}
